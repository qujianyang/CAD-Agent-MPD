# Paste these root-level values into Streamlit Community Cloud's Secrets field.
# Never commit a real `.streamlit/secrets.toml`.

LLM_PROVIDER = "openai"
OPENAI_API_KEY = "replace-with-the-approved-project-key"
OPENAI_MODEL = "gpt-5.4-mini"

EMBEDDING_PROVIDER = "openai"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
KNOWLEDGE_STORE_PATH = "artifacts/knowledge_embeddings_openai.json"

OPENAI_IMAGE_MODEL = "gpt-image-2"
